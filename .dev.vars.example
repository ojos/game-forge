# .dev.vars — Worker から見えるシークレットの雛形（値は書かない）。
#
# 使い方: このファイルを .dev.vars へコピーし、各自が値を入れる。
#   cp .dev.vars.example .dev.vars
#
# なぜ .env ではなくこのファイルか:
#   .env はこのリポジトリの「開発ツール」向け（gh の GH_TOKEN、第二意見の
#   GEMINI_API_KEY など）で、アプリケーションが読むべきものではない。wrangler は
#   既定で .env をシークレットとして Worker へ流し込むが、その経路は
#   CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false で止めてある
#   （scripts/dev-server.sh / package.json）。アプリ向けの値はこちらへ置く。
#
# 追跡除外: .dev.vars は .gitignore で除外済み。値を入れたままコミットされない。

# Amazon Bedrock を呼ぶための AWS 資格情報（確定19 / 4.1 / 9.1）。
#
# **接続先は Bedrock であり、Anthropic のキーは使わない**（v1.0 / #80）。認証は
# AWS 資格情報による SigV4 署名で、**接続経路は bedrock-runtime の Converse 1 本**
# である（4.1。Claude も Converse で動き usage 4 種もキャッシュも揃うことを実測したため、
# v1.1 の「Claude は Mantle」は撤回された）。実装は src/bedrock.ts。
#
# **どのモデルで生成するかはここに無い。** モデルの選択は秘密ではなく構成なので、
# wrangler.toml の GENERATION_MODEL が環境ごとに宣言する（確定5 / #83）。
#
# **BEDROCK_ 接頭辞を付ける理由。** このリポジトリは Terraform 用に AWS_PROFILE /
# AWS_ACCESS_KEY_ID を開発機の環境変数として使う（terraform/、docs/gcp-oauth-setup.md）。
# 同じ名前をアプリのシークレットにも使うと、どちらの資格情報で何を叩いているのかが
# 読めなくなる。用途が違うものには違う名前を付ける。
#
# **本番と開発で同じ枠を使わないこと。** 開発の実験が本番の枠に混ざると、4.3 の判定基準
# （プロバイダ層が先に発火したらアプリ層のバグ）が壊れる。分離の手段は #81 が決める。
#
# ローカルでは SSO の一時資格情報を使える。その場合は SESSION_TOKEN も要る。
#
# **export しただけでは足りない。** `aws configure export-credentials` が出すのは
# `AWS_*` という別の名前で、しかも Worker が読むのはシェルの環境変数ではなく
# `.dev.vars` というファイルである。**値を転記する**必要がある。
#
#   eval "$(AWS_PROFILE=game-forge-prod aws configure export-credentials --format env)"
#   printf 'BEDROCK_AWS_REGION=%s\nBEDROCK_AWS_ACCESS_KEY_ID=%s\nBEDROCK_AWS_SECRET_ACCESS_KEY=%s\nBEDROCK_AWS_SESSION_TOKEN=%s\n' \
#     ap-northeast-1 "$AWS_ACCESS_KEY_ID" "$AWS_SECRET_ACCESS_KEY" "$AWS_SESSION_TOKEN"
#
# 出力で .dev.vars の該当 4 行を置き換える。**SSO の資格情報は数時間で失効する**ので、
# 失効したら転記し直す。長命キーを使う場合は SESSION_TOKEN を空のままにする。
#
# 空のままでも `npm run dev` は起動する。
#
# **#160 以降、本番の Pages にはこの 4 つを登録しない。** 生成の実行体が
# オーケストレータ Lambda へ移り、AWS の中で IAM ロールを引き受けられるように
# なったためである（仕様 9.2 / docs/orchestrator.md）。この名前はコード側の口
# （src/bedrock.ts の BEDROCK_SECRET_NAMES）として残っており、Lambda 側は実行ロールの
# 一時資格情報をこの名前へ写して使う（src/orchestrator/handler.ts）。
#
# **したがってローカルでも、この 4 つだけでは /api/generate は通らない。** 既定の
# startJob は「オーケストレータへ非同期で投げる」実装で、投げ先は本番の Lambda である
# （Dev アカウントに Lambda は無い。確定20）。ローカルで生成の中身を確かめる手段は
# test/orchestrator.test.ts と scripts/bundle-orchestrator.sh である。
BEDROCK_AWS_REGION=
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
# 一時資格情報（SSO）を使うときだけ入れる。長命キーでは空のままにする。
BEDROCK_AWS_SESSION_TOKEN=

# ビルド関数（AWS Lambda `game-forge-build`）を呼ぶための AWS 資格情報
# （確定24 / 3.3-5 / 9.2 / #19）。
#
# 認証は Bedrock と同じく **IAM の SigV4** で、実装は src/build-client.ts。Workers は
# AWS の外で動くため IAM ロールを引き受ける経路が無く、長命のアクセスキーになる（4.1）。
#
# **Bedrock 用と分ける理由は 2 つある。**
#
#   1. 用途が違うものには違う名前を付ける（このファイルの BEDROCK_ 接頭辞と同じ方針）。
#   2. **権限が違う。** Bedrock を呼ぶ IAM ユーザーのポリシーは bedrock:InvokeModel
#      だけを許しており（terraform/bedrock.tf）、lambda:InvokeFunction を通せない。
#      最小権限を保つなら principal ごと分けることになる。
#
# **principal は terraform/build-invoker.tf が宣言している**（#115。IAM ユーザー
# game-forge-build-invoker。lambda:InvokeFunction をビルド関数の ARN 1 つだけに限る）。
# **アクセスキーだけは宣言しない**（aws_iam_access_key は tfstate へ平文で落ちる）。
# 鍵の発行・Pages への投入・ローテーションの手順は docs/build-invocation.md 3 章にある。
#
# **呼ぶ相手（関数名）はここに無い。** 秘密ではなく構成なので、wrangler.toml の
# BUILD_FUNCTION_NAME が環境ごとに宣言する。
#
# ローカルでは SSO の一時資格情報を使える。その場合は SESSION_TOKEN も要る
# （転記の手順は上の Bedrock の項と同じ。プロファイルは game-forge-prod）。
#
# **空のままでも npm run dev は起動する。** 呼び出しの手前で設定不足として落ちる。
BUILD_AWS_REGION=
BUILD_AWS_ACCESS_KEY_ID=
BUILD_AWS_SECRET_ACCESS_KEY=
# 一時資格情報（SSO）を使うときだけ入れる。長命キーでは空のままにする。
BUILD_AWS_SESSION_TOKEN=

# 署名付きセッション cookie の HMAC 鍵（8.1 / 確定9 / #12）。
#
# **32 文字以上**を入れること。短い鍵は実行時エラーとして表面化せず、総当たりの
# 容易さとしてだけ現れるため、src/session.ts が下限で弾く。空のままだと
# /auth/google/* は 503 を返す（認証を素通しさせないため）。
#
# 生成例:
#   openssl rand -base64 48
SESSION_SECRET=

# Google OAuth のクライアント ID とシークレット（8.1 / #12）。
#
# Google Cloud コンソールの「OAuth 2.0 クライアント ID」（種別: ウェブ アプリケーション）
# で発行する。承認済みのリダイレクト URI には、開発なら
#   https://game-forge.localtest.me:8787/auth/google/callback
# を登録する（ホストは wrangler.toml の APP_HOST、ポートは `npm run dev` のもの）。
#
# シークレットはこのファイル（.dev.vars.example）へ決して書かないこと。値は各自の
# .dev.vars にだけ置く（.dev.vars は .gitignore で除外済み）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# メール送信（Resend）の API キーと差出人（確定14 / 4.6 / 5.5 / #148 / #153）。
#
# **送信基盤は Resend で決着済み**（確定14）。無料枠 3,000通/月・100通/日・1ドメイン。
# HTTP API なので Workers の無料プランからそのまま呼べる（Cloudflare Email Sending は
# Workers 有料プランを要求するため採らない。仕様 5.5）。
#
# **1 本の経路を全通知が共有する。** 生成の完了（#153。生成 1 回につき 1 通、全体で
# 約 34 回/日）、費用 80% の警告（#148。月 1 通）、5.5 の改造通知（#36。未実装）の 3 つで、
# 日次 100 通に対する見積もりは src/mail/resend.ts の表にある。
#
# **RESEND_API_KEY** は Resend のダッシュボードで発行する（送信ドメインの権限のみ）。
# **MAIL_FROM** は差出人。`name <local@domain>` の形も使える。**送信ドメインは
# ojos.jp 系である**（7.2 のレピュテーションの項）。SPF / DKIM の到達性は本番ドメインでしか
# 確認できない（9.1 の表 / M5-5）。
#
# **空のままでも npm run dev は起動し、テストも通る。** 値が無い環境では通知は送信の
# 手前で止まる（src/mail/resend.ts の not-configured）。**テストはこの状態を前提にする**
# ——実際にメールを送るのは本番の外部サービスへの操作であり、検証の手段にしない。
RESEND_API_KEY=
MAIL_FROM=

# 費用 80% 警告の宛先（4.3 / #148）。
#
# **運用者のアドレスであり、利用者には出さない。** 80% はサービス全体の月次費用に対する
# 進捗で、個々の利用者の行動では変わらない（見せても利用者にできることが無い。#148 の決定）。
#
# **コードにも仕様書にも書かない。** 誰が運用しているかは環境ごとの設定であって実装の
# 一部ではないため、この雛形もキー名だけを共有する。
#
# 生成の完了通知（#153）はここを使わない。あちらの宛先は D1 の users.email である。
OPERATOR_EMAIL=
