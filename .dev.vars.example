# .dev.vars — Worker から見えるシークレットの雛形（値は書かない）。
#
# 使い方: このファイルを .dev.vars へコピーし、各自が値を入れる。
#   cp .dev.vars.example .dev.vars
#
# なぜ .env ではなくこのファイルか:
#   .env はこのリポジトリの「開発ツール」向け（gh の GH_TOKEN、第二意見の
#   GEMINI_API_KEY など）で、アプリケーションが読むべきものではない。wrangler は
#   既定で .env をシークレットとして Worker へ流し込むが、その経路は
#   CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false で止めてある
#   （scripts/dev-server.sh / package.json）。アプリ向けの値はこちらへ置く。
#
# 追跡除外: .dev.vars は .gitignore で除外済み。値を入れたままコミットされない。

# Claude Platform on AWS の **Dev 組織**で発行した API キー（確定19 / 9.2）。
#
# 本番の組織とは別枠であることが 4.3 の判定基準（プロバイダ層が先に発火したら
# アプリ層のバグ）を成立させる前提なので、ここへ Prod のキーを入れないこと。
#
# 空のままでも `wrangler dev` は起動する。実キーの発行は M0.5-1（#49）の範囲で、
# 2026-08-12 時点では Claude Platform on AWS のサインアップが AWS 側の理由で
# 未完了のため、まだ入れられない。
#
# **キーは AWS コンソール（Claude Platform on AWS → API keys）で発行する。**
# Claude Console で作ったキーはこのエンドポイントでは動かない。名前が紛らわしいので
# ANTHROPIC_ ではなく ANTHROPIC_AWS_ を接頭辞にしている（4.1 の認証方式）。
ANTHROPIC_AWS_API_KEY=

# Claude Platform on AWS のリージョンと Workspace ID（4.1 の認証方式）。
#
# **キーだけでは呼べない。** ベース URL がリージョンから決まり
# （https://aws-external-anthropic.{region}.api.aws）、リクエストには
# anthropic-workspace-id ヘッダが要る。どちらも機密ではないが、環境ごとに違う値なので
# ここへ置く。Workspace を分ける理由は 4.3（開発の実験が本番の spend limit に
# 混ざると「先に発火したらアプリ層のバグ」という判定基準が壊れる）。
ANTHROPIC_AWS_REGION=
ANTHROPIC_AWS_WORKSPACE_ID=

# 署名付きセッション cookie の HMAC 鍵（8.1 / 確定9 / #12）。
#
# **32 文字以上**を入れること。短い鍵は実行時エラーとして表面化せず、総当たりの
# 容易さとしてだけ現れるため、src/session.ts が下限で弾く。空のままだと
# /auth/google/* は 503 を返す（認証を素通しさせないため）。
#
# 生成例:
#   openssl rand -base64 48
SESSION_SECRET=

# Google OAuth のクライアント ID とシークレット（8.1 / #12）。
#
# Google Cloud コンソールの「OAuth 2.0 クライアント ID」（種別: ウェブ アプリケーション）
# で発行する。承認済みのリダイレクト URI には、開発なら
#   https://game-forge.localtest.me:8787/auth/google/callback
# を登録する（ホストは wrangler.toml の APP_HOST、ポートは wrangler dev のもの）。
#
# シークレットはこのファイル（.dev.vars.example）へ決して書かないこと。値は各自の
# .dev.vars にだけ置く（.dev.vars は .gitignore で除外済み）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
