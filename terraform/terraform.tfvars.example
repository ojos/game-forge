# terraform.tfvars の雛形。
#
# 使い方: このファイルを terraform.tfvars へコピーし、値を各自の環境に合わせて設定する。
# terraform.tfvars は .gitignore（*.tfvars）で追跡から外れている。
#
# 機密（GitHub トークン等）はここへ書かない。トークンは環境変数で渡す。
#   export GITHUB_TOKEN="$(gh auth token)"

# Actions 変数 ALLOWED_AUTHOR_EMAILS の値。カンマ区切りで複数指定できる。
# 例: "your-name@example.com,another@example.com"
allowed_author_emails = ""

# 既定値から変える場合のみ指定する。
# github_owner    = "ojos"
# repository_name = "game-forge"

# 本番 AWS アカウント（game-forge-prod）のアカウント ID。12 桁の数字。
# provider "aws" の allowed_account_ids に渡り、別アカウントのプロファイルで
# 適用しようとしたときに apply を失敗させる。
# 機密ではないが、このリポジトリは公開のため宣言側には書かない。
aws_account_id_prod = "000000000000"

# 既定値から変える場合のみ指定する。
# aws_region    = "ap-northeast-1"
# dns_zone_name = "game-forge.ojos.jp"

# GCP 組織（ojos.jp）の ID。数字のみ。
# 確認方法: gcloud organizations list
# 機密ではないが、このリポジトリは公開のため宣言側には書かない。
gcp_org_id = "000000000000"

# 本番の GCP プロジェクトに紐付けた請求先アカウントの ID（#487）。
# 大文字英数字 6 桁をハイフンで 3 つつないだ形式。"billingAccounts/" の接頭辞は付けない。
# 既定値は無い。値を入れずに plan すると変数の不足で止まる（紐付けを外す差分を出させない）。
# 機密ではないが、このリポジトリは公開のため宣言側には書かない。
gcp_billing_account = "000000-000000-000000"

# 既定値から変える場合のみ指定する。
# gcp_project_id   = "ojos-game-forge"
# gcp_project_name = "game-forge"

# 開発用の GCP プロジェクト（#479）に紐付いている請求先アカウントの ID。形式は gcp_billing_account と同じ。
# Console で作成したときに自動で紐付き、利用者の判断で残した。本番と同じ値でも、別のキーで受ける。
# 既定値は無い。値を入れずに plan すると変数の不足で止まる（紐付けを外す差分を出させない）。
# 機密ではないが、このリポジトリは公開のため宣言側には書かない。
gcp_dev_billing_account = "000000-000000-000000"

# 開発用の GCP プロジェクト（#479）。既定値は実在するプロジェクトなので、ふつうは指定しない。
# gcp_dev_project_id を変えるときは、terraform/gcp.tf の import ブロックの id も変える。
# gcp_dev_project_id   = "ojos-game-forge-dev"
# gcp_dev_project_name = "game-forge-dev"

# 費用ガードの層 3（AWS Budgets）が通知を送る宛先（#82 / 仕様 4.3）。
# Budgets Actions は subscriber を必須としているため省略できない。
# 機密ではないが、このリポジトリは公開のため宣言側には書かない。
budget_notification_email = "you@example.com"

# Cloudflare のアカウント ID。16 進 32 桁。
# R2 のライフサイクル宣言（terraform/r2-lifecycle.tf）が使う。
# 値は .env の CLOUDFLARE_ACCOUNT_ID と同じもの。**API トークンはここへ書かない**
# （プロバイダが環境変数 CLOUDFLARE_API_TOKEN から読む。providers.tf の注記）。
# 機密ではないが、このリポジトリは公開のため宣言側には書かない。
cloudflare_account_id = "00000000000000000000000000000000"

# Cloudflare Zero Trust のチーム名（#792 / M22-2）。Access のログインが載る
# <team>.cloudflareaccess.com の左端。**後から変えられないものとして扱う**
# （変えると Access のログイン URL と、コネクタ側の検査 team_name が一斉にずれる）。
# 機密ではないが、このリポジトリは公開のため宣言側には書かない。
cloudflare_zero_trust_team_name = "your-team"

# Zero Trust の ID プロバイダ（Google Workspace）が使う OAuth クライアント（#792）。
# **GCP コンソールで作る**（API では作れない。docs/gcp-oauth-setup.md の既存の 2 つと同じ手順）。
# リダイレクト URI は https://<team>.cloudflareaccess.com/cdn-cgi/access/callback。
zero_trust_google_client_id     = "000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
# **これは機密である。** tfvars は追跡外。値は GCP コンソールが 1 回だけ見せる。
zero_trust_google_client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

# SSH の口（dev01-ssh.ojos.jp）へ入れる人（#792）。ojos.jp の Workspace のアカウント。
# ドメインで括らず名指しにする理由は terraform/tunnel-dev01.tf にある。
zero_trust_operator_emails = ["you@ojos.jp"]
